generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  role         Role
  name         String   // 👈 ОБОВʼЯЗКОВЕ
  barberPercent Int     @default(0)
  cosmeticsPercent Int  @default(0)
  createdAt    DateTime @default(now())
	isActive     Boolean  @default(true)
  transactions Transaction[]
  salaryExpenses Expense[] @relation("SalaryUserExpenses")
}

enum Role {
  ADMIN
  USER
}

model Shift {
  id        Int      @id @default(autoincrement())
  isOpen    Boolean
  cashStart Int?
  cashEnd   Int?
  openedAt  DateTime
  closedAt  DateTime?
  transactions Transaction[]
  expenses     Expense[]
}

model Transaction {
  id            Int      @id @default(autoincrement())
  amount        Int
  paymentMethod String
  serviceType   ServiceType @default(BARBER)
  createdAt     DateTime
  userId        Int
  shiftId       Int

  user  User  @relation(fields: [userId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id])
}

enum ServiceType {
  BARBER
  COSMETICS
}

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Int
  category  ExpenseCategory @default(OTHER)
  salaryUserId Int?
  comment   String?
  createdAt DateTime
  shiftId   Int

  shift Shift @relation(fields: [shiftId], references: [id])
  salaryUser User? @relation("SalaryUserExpenses", fields: [salaryUserId], references: [id])
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  OTHER
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
